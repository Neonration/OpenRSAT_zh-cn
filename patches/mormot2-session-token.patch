 { TLdapClient }
 
+type
+  TLdapSessionToken = class(TInterfacedObject, ILdapSessionToken)
+  private
+    fInvalid: LongInt;
+  public
+    function IsValid: boolean;
+    procedure Invalidate;
+  end;
+
+function TLdapSessionToken.IsValid: boolean;
+begin
+  result := InterlockedCompareExchange(fInvalid, 0, 0) = 0;
+end;
+
+procedure TLdapSessionToken.Invalidate;
+begin
+  InterlockedExchange(fInvalid, 1);
+end;
