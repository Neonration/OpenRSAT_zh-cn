+
+procedure TLdapClient.InvalidateSessionToken;
+begin
+  if fSessionToken <> nil then
+    fSessionToken.Invalidate;
+  fSessionToken := nil; // No allocation; retained readers keep a revoked object.
+end;
+
+procedure TLdapClient.NewSessionToken;
+begin
+  InvalidateSessionToken;
+  fSessionToken := TLdapSessionToken.Create;
+end;
